# Google Gemini API Key (Get yours free from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Selection (e.g., gemini/gemini-3.0-flash, gemini/gemini-3.5-flash, gemini/gemini-3.8-pro)
GEMINI_MODEL=gemini/gemini-3.5-flash

# Default Report Language (English, Spanish, French, German, Hindi, etc.)
DEFAULT_LANGUAGE=English

# Logging Level (INFO, DEBUG, WARNING, ERROR)
LOG_LEVEL=INFO
